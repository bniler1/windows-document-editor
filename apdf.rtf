\pard\brdrb\brdrs\brdrw20\brsp80 \widctlpar\sa300\qc\cf1\expndtw5\kerning28\b\f0\fs44 Adobe Acrobat XI (11.0)\cf2\b0\f1\fs52\par

\pard\widctlpar\sa40\sl276\slmult1\qc\cf3\expndtw0\kerning0\i\f0\fs24 Complete Feature Reference  \emdash   2012\cf0\i0\fs20\par

\pard\widctlpar\sa40\sl276\slmult1\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 1. PDF Creation\f1\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\f0\fs22 From Desktop Applications\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Print to Adobe PDF printer from any application that can print (Word, Excel, PowerPoint, AutoCAD, etc.)\par
\bullet  PDFMaker add-in for Microsoft Office (Word, Excel, PowerPoint, Outlook, Project, Visio, Publisher)\par
\bullet  PDFMaker for Lotus Notes, AutoCAD, Internet Explorer, Firefox\par
\bullet  One-click PDF creation from the Acrobat ribbon in Office\par
\bullet  Create PDF from clipboard contents\par
\bullet  Create PDF from a blank page and build content from scratch\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 From Files & Folders\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Create PDF from a single file (Word, Excel, PPT, JPG, PNG, TIFF, BMP, HTML, text, RTF, and 100+ formats)\par
\bullet  Combine multiple files into a single PDF (drag-and-drop merge)\par
\bullet  Create PDF Portfolio (multi-file container)\par
\bullet  Batch convert an entire folder of files to PDF\par
\bullet  Create PDF from a web page (enter URL, crawl site to specified depth)\par
\bullet  Create PDF from a scanner (flatbed or document feeder)\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 2. PDF Editing (Direct Edit \emdash  New in XI)\f1\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\f0\fs22 Edit Text\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Click to select and edit any text block directly in the PDF\par
\bullet  Add new text anywhere on the page\par
\bullet  Delete text\par
\bullet  Change font, font size, font color, bold, italic, underline\par
\bullet  Auto-reflow of text within a text block (text wraps within its bounding box)\par
\bullet  Move and resize text blocks by dragging\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Edit Images\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Click to select any image in the PDF\par
\bullet  Move, resize, rotate, and flip images\par
\bullet  Delete or replace image with a new image file\par
\bullet  Open image in external editor (Photoshop, etc.) and update automatically on save\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Edit Objects\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Select and move any page object (text block, image, graphic)\par
\bullet  Bring to front, send to back, bring forward, send backward\par
\bullet  Align multiple objects: left, right, top, bottom, center, distribute evenly\par
\bullet  Resize, group, ungroup, cut, copy, paste objects\par
\bullet  Undo/redo editing actions\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Page Management\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Insert blank pages or pages from another PDF\par
\bullet  Delete, extract, and replace pages\par
\bullet  Move and rearrange pages (drag in Pages panel)\par
\bullet  Rotate pages: 90\'b0, 180\'b0, 270\'b0 (temporary view or permanent)\par
\bullet  Crop pages (set crop, trim, bleed, art, media box)\par
\bullet  Split document into multiple PDFs (by page range, file size, or top-level bookmarks)\par
\bullet  Bates numbering (see Legal section)\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Headers, Footers, Backgrounds & Watermarks\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Add/edit/remove header and footer text (date, time, page number tokens)\par
\bullet  Font, size, color, and position for header/footer; apply to all pages, page range, odd/even pages\par
\bullet  Add/edit/remove background (color, image, or PDF page) with opacity, position, scale settings\par
\bullet  Text or image watermark: opacity, rotation, position, scale, page range\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 3. Viewing\f1\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\f0\fs22 Navigation\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Page navigation: arrows, jump-to-page, first/last page\par
\bullet  Scroll modes: single page, continuous, facing (two-up), continuous facing\par
\bullet  Zoom: 25%-6400%, fit page, fit width, fit height, actual size, reflow\par
\bullet  Pan (hand tool), Marquee zoom, Loupe tool, Pan & Zoom window\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\bullet  \cf4\b\fs22 View Modes\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Read Mode: full-screen-like, hides all panels and toolbars\par
\bullet  Full Screen Mode: completely immersive, hides all OS chrome\par
\bullet  Two-Up and Continuous Facing page views\par
\bullet  Portfolio view (for PDF Portfolios)\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Display Settings\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Rotate view (temporary, not saved)\par
\bullet  Show/hide rulers, grids, guides; snap to grid\par
\bullet  Show art box, trim box, bleed box, crop box (for print professionals)\par
\bullet  Overprint preview (simulate overprint behavior for print)\par
\bullet  Soft-proof colors (simulate printer output on screen)\par
\bullet  Anti-aliased text, line art, and smooth zooming\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 5. Forms\f1\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\f0\fs22 Creating Forms\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Auto-detect form fields from existing PDF (recognizes lines and labels)\par
\bullet  Create form fields manually with the Form Editor\par
\bullet  Field types: Text Field, Check Box, Radio Button, List Box, Combo Box, Button, Signature Field, Barcode Field\par
\bullet  Import form data from another PDF or spreadsheet\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Field Properties\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Text Field: multi-line, scrolling, character limit, comb layout, password masking, file select, default value, tooltip\par
\bullet  Check Box / Radio Button: export value, default state, mutually exclusive radio groups\par
\bullet  List Box / Combo Box: list items, allow custom text entry, allow multiple selection, sort items\par
\bullet  Button: actions on mouse up/down/enter/exit/focus/blur \emdash  submit, reset, show/hide, JavaScript, open file/URL, play media\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Distribution & Collection\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f0\fs20\bullet  Import responses into a spreadsheet (compile data from multiple returns)\par
\bullet  Export form data: FDF, XFDF, XML, CSV/tab-delimited\par
\bullet  Enable Reader rights (allow free Reader users to save form data \emdash  Reader Extended PDF)\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 7. OCR (Optical Character Recognition)\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Recognize text in scanned PDFs and image-based PDFs (make searchable)\par
\bullet  OCR languages: 40+ languages supported\par
\bullet  Output style \emdash  Searchable Image (exact): keeps original image, adds invisible text layer\par
\bullet  Output style \emdash  Searchable Image (compact): compresses image, adds invisible text layer\par
\bullet  Output style \emdash  ClearScan: synthesizes a custom font matching scanned text; smallest file, sharp at any zoom\par
\bullet  Output style \emdash  Editable Text and Images: replaces scanned content with live editable text and images\par
\bullet  Correct OCR suspects: view uncertain results, correct one by one\par
\bullet  Run OCR on single page, page range, entire document, or batch folder of PDFs\par
\bullet  OCR produces searchable, selectable, and copyable text\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 8. Search & Accessibility\f1\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\f0\fs22 Search\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Simple search (Ctrl+F): find text on current page or full document\par
\bullet  Full Search panel: case-sensitive, whole words, Boolean (AND, OR, NOT), proximity (NEAR), wildcards (?, *)\par
\bullet  Search across multiple PDFs in a folder\par
\bullet  Search PDF Portfolios, comments, bookmarks, and document metadata\par
\bullet  Full-text Catalog index: create a search index for large collections for fast enterprise search\par
\bullet  Catalog: incremental update, purge and rebuild, set schedule\par
\bullet  Embedded index in a single PDF for fast search\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 10. PDF Portfolios\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Combine multiple files of different types into one PDF Portfolio container (native files embedded, not flattened)\par
\bullet  Supported file types: PDF, Word, Excel, PowerPoint, images, video, audio, HTML, CAD, and any file type\par
\bullet  Portfolio layouts: Grid, Linear, Wave, Freeform, Click-Through\par
\bullet  Customize appearance: theme colors, background, header image, fonts\par
\bullet  Add/remove files; rearrange files; create folder hierarchy\par
\bullet  Define detail columns (metadata): File Name, Description, Modified Date, Size, custom columns\par
\bullet  Sort files by any column\par
\bullet  Search across all files in the Portfolio\par
\bullet  Preview files in the Portfolio viewer without extracting\par
\bullet  Extract individual files; send Portfolio as a single PDF attachment\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 11. Export & Conversion\f1\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\f0\fs22 Export PDF to Other Formats\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Microsoft Word (.docx or .doc) \emdash  preserves layout, fonts, formatting\par
\bullet  Microsoft Excel (.xlsx) \emdash  extracts tables to spreadsheet cells\par
\bullet  Microsoft PowerPoint (.pptx) \emdash  converts pages to slides\par
\bullet  Rich Text Format (.rtf)\par
\bullet  Plain Text (.txt)\par
\bullet  HTML (web page) and XML\par
\bullet  Image formats: JPEG, JPEG 2000, PNG, TIFF, BMP, GIF, PCX, TARGA\par
\bullet  PostScript (.ps) and Encapsulated PostScript (.eps)\par
\bullet  Single image per page or one multi-page TIFF\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Export Settings\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Word: layout vs. flowing text, include comments/images\par
\bullet  Excel: table detection settings\par
\bullet  Image: color space (RGB, CMYK, Grayscale), resolution (DPI), compression, color management\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\b\fs22 Save As Other\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Reduced Size PDF (compress for older compatibility)\par
\bullet  Certified Document\par
\bullet  Reader Extended PDF: Enable Commenting & Measuring; Enable Form Fill-in & Save; Enable All Features\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 13. Compare Documents\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Compare two PDFs and generate a report showing all differences\par
\bullet  Comparison types: text only, images only, or text and images\par
\bullet  Results shown as highlights in the original documents side-by-side\par
\bullet  Summary panel lists every change found; navigate through changes one by one\par
\bullet  Works even if PDFs are formatted differently (intelligent text comparison)\par
\bullet  Ideal for legal documents, contracts, engineering drawings\par
\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 24. Preferences & Customization\f1\par

\pard\keep\keepn\widctlpar\s2\sb160\sa40\sl276\slmult1\cf4\f0\fs22 General Preferences\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Startup: open at last page or first page, restore previous documents\par
\bullet  Automatically save recovery info every N minutes\par
\bullet  Show recent documents on Home screen\par
\bullet  Page display defaults: layout, zoom, smooth text/images/line art\par
\bullet  Full-screen transition effects; page caching and memory usage settings\par

\pard\widctlpar\sa40\sl276\slmult1\par

\pard\keep\keepn\widctlpar\s1\sb280\sa80\sl276\slmult1\cf1\b\fs28 27. compatible OS\f1\par

\pard\widctlpar\fi-216\li432\sa20\sl276\slmult1\cf0\b0\f2\fs20\bullet\f0  Windows: XP SP3, Vista SP2, Windows 7, Windows 8 (32-bit and 64-bit)\par
\par
}
